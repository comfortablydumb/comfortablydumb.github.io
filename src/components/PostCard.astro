---
import type { Post } from "../utils/posts";
import FormattedDate from "./FormattedDate.astro";

interface Props {
  post: Post;
  compact?: boolean;
}
const { post, compact = false } = Astro.props;
---

<article class="post-row">
  <span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
  <a class="post-link" href={`/blog/${post.id}`}>{post.data.title}</a>
  {!compact && <p class="post-desc text-muted">{post.data.description}</p>}
</article>

<style>
  .post-row {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0 0.75rem;
    padding: 0.4rem 0;
    align-items: baseline;
  }
  .post-date {
    font-size: 0.85rem;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
  .post-link {
    text-decoration: none;
    color: var(--text);
  }
  .post-link:hover {
    color: var(--link);
    text-decoration: underline;
  }
  .post-desc {
    grid-column: 2;
    font-size: 0.92rem;
    margin: 0.15rem 0 0;
  }
  @media (max-width: 460px) {
    .post-row {
      grid-template-columns: 1fr;
    }
    .post-desc {
      grid-column: 1;
    }
  }
</style>
