---
// Cmd-K command palette: jump to any note, navigate, or toggle the theme
// without leaving the keyboard. Items are injected at build time; filtering
// is instant client-side substring matching. Hidden until opened, and a
// no-JS visitor simply never sees it (all real navigation still works).
import { getPosts } from "../utils/posts";
import { NAV, SOCIALS } from "../config";

const posts = await getPosts();

type Item = {
  label: string;
  hint: string;
  href?: string;
  action?: "theme";
  external?: boolean;
};

const items: Item[] = [
  ...NAV.map((n) => ({ label: n.label, hint: "Go", href: n.href })),
  { label: "Toggle theme", hint: "Action", action: "theme" as const },
  { label: "Email", hint: "Contact", href: `mailto:${SOCIALS.email}`, external: true },
  ...(SOCIALS.linkedin
    ? [{ label: "LinkedIn", hint: "Contact", href: SOCIALS.linkedin, external: true }]
    : []),
  { label: "RSS feed", hint: "Contact", href: "/rss.xml", external: true },
  ...posts.map((p) => ({
    label: p.data.title,
    hint: "Note",
    href: `/blog/${p.id}`,
  })),
];
---

<div id="cmdk" class="cmdk" hidden aria-hidden="true">
  <div class="cmdk-backdrop" data-cmdk-close></div>
  <div
    class="cmdk-panel"
    role="dialog"
    aria-modal="true"
    aria-label="Command palette"
  >
    <div class="cmdk-input-row">
      <svg class="cmdk-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      <input
        id="cmdk-input"
        type="text"
        placeholder="Jump to a note, page, or action…"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        aria-controls="cmdk-list"
        aria-expanded="true"
      />
      <kbd class="cmdk-esc">Esc</kbd>
    </div>
    <ul id="cmdk-list" class="cmdk-list" role="listbox" aria-label="Results"></ul>
    <p id="cmdk-empty" class="cmdk-empty" hidden>No matches</p>
  </div>
</div>

<script is:inline define:vars={{ items }}>
  (function () {
    var root = document.getElementById("cmdk");
    if (!root) return;
    var input = document.getElementById("cmdk-input");
    var list = document.getElementById("cmdk-list");
    var empty = document.getElementById("cmdk-empty");
    var active = 0;
    var filtered = items.slice();

    function open() {
      root.hidden = false;
      root.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      input.value = "";
      render(items.slice());
      // focus after the element is shown
      requestAnimationFrame(function () {
        input.focus();
      });
    }

    function close() {
      root.hidden = true;
      root.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }

    function isOpen() {
      return !root.hidden;
    }

    function score(item, q) {
      var label = item.label.toLowerCase();
      var idx = label.indexOf(q);
      if (idx === -1) return -1;
      // prefer matches at the start of the label
      return idx === 0 ? 0 : 1;
    }

    function filter(q) {
      q = q.trim().toLowerCase();
      if (!q) return items.slice();
      return items
        .map(function (item) {
          return { item: item, s: score(item, q) };
        })
        .filter(function (r) {
          return r.s !== -1;
        })
        .sort(function (a, b) {
          return a.s - b.s;
        })
        .map(function (r) {
          return r.item;
        });
    }

    function render(results) {
      filtered = results;
      active = 0;
      list.innerHTML = "";
      empty.hidden = results.length > 0;
      results.forEach(function (item, i) {
        var li = document.createElement("li");
        li.className = "cmdk-item" + (i === active ? " is-active" : "");
        li.setAttribute("role", "option");
        li.setAttribute("aria-selected", i === active ? "true" : "false");
        li.dataset.index = String(i);
        var label = document.createElement("span");
        label.className = "cmdk-item-label";
        label.textContent = item.label;
        var hint = document.createElement("span");
        hint.className = "cmdk-item-hint";
        hint.textContent = item.hint;
        li.appendChild(label);
        li.appendChild(hint);
        li.addEventListener("mousemove", function () {
          setActive(i);
        });
        li.addEventListener("click", function () {
          execute(item);
        });
        list.appendChild(li);
      });
    }

    function setActive(i) {
      if (i < 0 || i >= filtered.length || i === active) return;
      var nodes = list.children;
      if (nodes[active]) {
        nodes[active].classList.remove("is-active");
        nodes[active].setAttribute("aria-selected", "false");
      }
      active = i;
      if (nodes[active]) {
        nodes[active].classList.add("is-active");
        nodes[active].setAttribute("aria-selected", "true");
        nodes[active].scrollIntoView({ block: "nearest" });
      }
    }

    function toggleTheme() {
      var el = document.documentElement;
      var next = el.getAttribute("data-theme") === "dark" ? "light" : "dark";
      el.setAttribute("data-theme", next);
      try {
        localStorage.setItem("theme", next);
      } catch (e) {}
      var meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute("content", next === "dark" ? "#1b1c1e" : "#ffffff");
    }

    function execute(item) {
      if (!item) return;
      if (item.action === "theme") {
        toggleTheme();
        close();
        return;
      }
      if (item.href) {
        close();
        if (item.external) {
          window.open(item.href, "_blank", "noopener");
        } else {
          window.location.href = item.href;
        }
      }
    }

    input.addEventListener("input", function () {
      render(filter(input.value));
    });

    // Global keyboard: open with Cmd/Ctrl+K or "/", drive the list while open.
    document.addEventListener("keydown", function (e) {
      var mod = e.metaKey || e.ctrlKey;
      if (mod && (e.key === "k" || e.key === "K")) {
        e.preventDefault();
        isOpen() ? close() : open();
        return;
      }
      if (!isOpen() && e.key === "/") {
        var t = e.target;
        var tag = t && t.tagName ? t.tagName.toLowerCase() : "";
        var typing = tag === "input" || tag === "textarea" || (t && t.isContentEditable);
        if (!typing) {
          e.preventDefault();
          open();
        }
        return;
      }
      if (!isOpen()) return;
      if (e.key === "Escape") {
        e.preventDefault();
        close();
      } else if (e.key === "ArrowDown") {
        e.preventDefault();
        setActive(Math.min(active + 1, filtered.length - 1));
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        setActive(Math.max(active - 1, 0));
      } else if (e.key === "Enter") {
        e.preventDefault();
        execute(filtered[active]);
      }
    });

    root.addEventListener("click", function (e) {
      if (e.target && e.target.hasAttribute("data-cmdk-close")) close();
    });
  })();
</script>

<style>
  .cmdk {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(3rem, 12vh, 8rem) 1rem 1rem;
  }
  .cmdk[hidden] {
    display: none;
  }
  .cmdk-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(2px);
  }
  .cmdk-panel {
    position: relative;
    width: min(36rem, 100%);
    max-height: 70vh;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
    overflow: hidden;
  }
  .cmdk-input-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border);
  }
  .cmdk-search-icon {
    color: var(--text-faint);
    flex: none;
  }
  #cmdk-input {
    flex: 1;
    border: none;
    background: none;
    color: var(--text);
    font: inherit;
    font-size: 1rem;
    outline: none;
  }
  #cmdk-input::placeholder {
    color: var(--text-faint);
  }
  .cmdk-esc {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-faint);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 0.1rem 0.35rem;
    flex: none;
  }
  .cmdk-list {
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    overflow-y: auto;
  }
  .cmdk-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0.7rem;
    border-radius: 8px;
    cursor: pointer;
  }
  .cmdk-item.is-active {
    background: var(--bg-subtle);
  }
  .cmdk-item-label {
    color: var(--text);
    font-size: 0.95rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cmdk-item-hint {
    color: var(--text-faint);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    flex: none;
  }
  .cmdk-empty {
    padding: 1rem;
    margin: 0;
    color: var(--text-faint);
    font-size: 0.9rem;
    text-align: center;
  }
  .cmdk-empty[hidden] {
    display: none;
  }
</style>
