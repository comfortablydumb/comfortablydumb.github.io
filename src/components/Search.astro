---
// Client-side search powered by Pagefind. The index and UI assets under
// /pagefind/ are generated by `pagefind --site dist` after `astro build`,
// so search is active in production/preview builds (not in `astro dev`).
---

<div class="search">
  <div id="search"></div>
</div>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script is:inline>
  (function () {
    function init() {
      if (typeof window.PagefindUI === "undefined") return;
      new window.PagefindUI({
        element: "#search",
        showSubResults: false,
        showImages: false,
        showEmptyFilters: false,
        excerptLength: 0,
        pageSize: 5,
        resetStyles: false,
      });
    }
    var s = document.createElement("script");
    s.src = "/pagefind/pagefind-ui.js";
    s.onload = init;
    s.onerror = function () {
      var el = document.getElementById("search");
      if (el)
        el.innerHTML =
          '<p class="search-hint">Search is available on the published site.</p>';
    };
    document.head.appendChild(s);
  })();
</script>

<style>
  .search {
    margin-bottom: 1.75rem;
  }
  .search-hint {
    color: var(--text-faint);
    font-size: 0.9rem;
  }
  /*
    Target Pagefind internals through the stable #search id in a single
    :global() wrapper. Scoping each selector with ".search :global(...)"
    is fragile: Astro can drop the scope prefix off the first item in a
    comma list, leaving a bare low-specificity selector that Pagefind's
    own CSS overrides. #search (id) keeps specificity above Pagefind's.
  */
  :global(#search .pagefind-ui) {
    --pagefind-ui-primary: var(--link);
    --pagefind-ui-text: var(--text);
    --pagefind-ui-background: var(--bg);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: var(--border);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 10px;
    --pagefind-ui-font: inherit;
  }
  /* Minimal results: title-only, no excerpts or match context. */
  :global(#search .pagefind-ui__result-excerpt),
  :global(#search .pagefind-ui__result-tags),
  :global(#search .pagefind-ui__button) {
    display: none;
  }
  /* Strip the boxed "Clear" button down to a quiet text affordance. */
  :global(#search .pagefind-ui__search-clear) {
    background: none;
    border: none;
    padding: 0 0.25rem;
    width: auto;
    font-size: 0.8rem;
    color: var(--text-faint);
    text-indent: 0;
  }
  :global(#search .pagefind-ui__search-clear:hover) {
    color: var(--link);
  }
  /* The result count: small and muted, not a heavy heading. */
  :global(#search .pagefind-ui__message) {
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--text-faint);
    padding: 0.5rem 0 0;
  }
  :global(#search .pagefind-ui__result) {
    padding: 0.55rem 0;
    border: none;
    border-top: 1px solid var(--border);
  }
  :global(#search .pagefind-ui__result-title) {
    font-size: 1rem;
    font-weight: 500;
  }
  :global(#search .pagefind-ui__result-link) {
    color: var(--text);
    text-decoration: none;
  }
  :global(#search .pagefind-ui__result-link:hover) {
    color: var(--link);
    text-decoration: underline;
  }
</style>
