---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPosts } from "../utils/posts";

const recent = (await getPosts()).slice(0, 3);
---

<BaseLayout title="Not found" noindex>
  <section class="nf">
    <p class="code">404</p>
    <h1>This page wandered off.</h1>
    <p class="lead">
      Either it never existed, or it moved and forgot to leave a forwarding
      address. Classic distributed-systems behavior: the request was routed, the
      node was not found.
    </p>

    <div class="nf-actions">
      <a class="btn btn-primary" href="/">Back home</a>
      <a class="btn" href="/blog">Browse notes</a>
    </div>

    {
      recent.length > 0 && (
        <div class="suggest">
          <p class="suggest-label">Or pick up one of these instead</p>
          <ul>
            {recent.map((p) => (
              <li>
                <a href={`/blog/${p.id}`}>{p.data.title}</a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  .nf {
    text-align: center;
    padding-block: clamp(2.5rem, 9vw, 5.5rem);
  }
  .code {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.3em;
    color: var(--text-faint);
    margin: 0 0 0.5rem;
  }
  .nf h1 {
    margin: 0;
  }
  .lead {
    margin: 0.9rem auto 0;
    max-width: 46ch;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .nf-actions {
    display: flex;
    gap: 0.6rem;
    justify-content: center;
    align-items: center;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }
  .nf-actions .btn {
    padding: 0.5rem 1.1rem;
    line-height: 1.4;
  }
  .suggest {
    margin-top: 2.5rem;
  }
  .suggest-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-faint);
    margin-bottom: 0.6rem;
  }
  .suggest ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.4rem;
  }
  .suggest a {
    text-decoration: none;
    color: var(--text);
  }
  .suggest a:hover {
    color: var(--link);
    text-decoration: underline;
  }
</style>
