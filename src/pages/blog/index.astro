---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { getPosts, getTags, slugifyTag } from "../../utils/posts";

const posts = await getPosts();
const tags = await getTags();

const rows = posts.map((p) => ({
  id: p.id,
  title: p.data.title,
  date: p.data.pubDate.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  }),
  iso: p.data.pubDate.toISOString(),
}));
---

<BaseLayout
  title="Blog"
  description="Engineering writing by Samarth Jindal on distributed systems, Kafka, Kubernetes, production engineering, and system design."
>
  <PageHeader
    title="Notes"
    description="Mostly software — incidents, system design, performance work, and the occasional note on careers and decisions."
  />

  {
    tags.length > 0 && (
      <nav class="tags" aria-label="Browse by topic">
        {tags.map(({ tag, count }) => (
          <a href={`/tags/${slugifyTag(tag)}`}>
            {tag} <span class="count">{count}</span>
          </a>
        ))}
      </nav>
    )
  }

  <div class="list">
    {
      rows.map((p) => (
        <article class="row">
          <time class="date" datetime={p.iso}>
            {p.date}
          </time>
          <a href={`/blog/${p.id}`}>{p.title}</a>
        </article>
      ))
    }
  </div>
</BaseLayout>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    margin-bottom: 1.5rem;
  }
  .tags a {
    font-size: 0.85rem;
    color: var(--text-muted);
    text-decoration: none;
  }
  .tags a:hover {
    color: var(--link);
    text-decoration: underline;
  }
  .count {
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
  .list {
    display: grid;
    gap: 0.1rem;
  }
  .row {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0 0.75rem;
    padding: 0.4rem 0;
    align-items: baseline;
  }
  .date {
    font-size: 0.85rem;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
  .row a {
    text-decoration: none;
    color: var(--text);
  }
  .row a:hover {
    color: var(--link);
    text-decoration: underline;
  }
  @media (max-width: 460px) {
    .row {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
</style>
