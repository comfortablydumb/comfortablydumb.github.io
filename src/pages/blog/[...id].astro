---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { getPosts, readingTime, slugifyTag } from "../../utils/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const mins = d.readingTime ?? readingTime(post.body);

const all = await getPosts();
const related = all
  .filter((p) => p.id !== post.id)
  .filter(
    (p) =>
      p.data.category === d.category ||
      p.data.tags.some((t) => d.tags.includes(t)),
  )
  .slice(0, 3);
---

<BaseLayout
  title={d.title}
  description={d.description}
  image={`/og/${post.id}.png`}
  type="article"
  publishDate={d.pubDate}
  modifiedDate={d.updatedDate}
  tags={d.tags}
>
  <article data-pagefind-body>
    <header class="post-head">
      <h1>{d.title}</h1>
      <p class="post-meta text-muted">
        <FormattedDate date={d.pubDate} /> · {mins} min read · {d.category}
        {d.updatedDate && <> · updated <FormattedDate date={d.updatedDate} /></>}
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="post-foot">
      <p class="tags">
        {d.tags.map((t) => <a href={`/tags/${slugifyTag(t)}`}>#{t}</a>)}
      </p>
      <div class="foot-row">
        <a href="/blog" class="back">← All notes</a>
        <div class="share" data-pagefind-ignore>
          <span class="share-status" data-share-status role="status" aria-live="polite"></span>
          <button type="button" class="icon-btn" data-copy-link aria-label="Copy link" title="Copy link">
            <svg class="i-copy" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <svg class="i-check" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 6 9 17l-5-5"></path>
            </svg>
          </button>
          <button type="button" class="icon-btn" data-share-link hidden aria-label="Share" title="Share">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="18" cy="5" r="3"></circle>
              <circle cx="6" cy="12" r="3"></circle>
              <circle cx="18" cy="19" r="3"></circle>
              <path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"></path>
            </svg>
          </button>
        </div>
      </div>
    </footer>

    {
      related.length > 0 && (
        <section class="related" data-pagefind-ignore>
          <h2>Related</h2>
          <ul>
            {related.map((p) => (
              <li>
                <a href={`/blog/${p.id}`}>{p.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .post-head {
    margin-bottom: 1.5rem;
  }
  .post-meta {
    font-size: 0.88rem;
    margin-top: 0.4rem;
  }
  .post-foot {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0 0 0.75rem;
  }
  .tags a {
    font-size: 0.88rem;
    color: var(--text-muted);
    text-decoration: none;
  }
  .tags a:hover {
    color: var(--link);
  }
  .back {
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--text-muted);
  }
  .back:hover {
    color: var(--link);
  }
  .foot-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .share {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .share-status {
    font-size: 0.8rem;
    color: var(--text-faint);
  }
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    padding: 0;
    color: var(--text-muted);
    cursor: pointer;
  }
  .icon-btn:hover {
    color: var(--link);
  }
  .icon-btn .i-check {
    display: none;
  }
  .icon-btn.copied {
    color: var(--link);
  }
  .icon-btn.copied .i-copy {
    display: none;
  }
  .icon-btn.copied .i-check {
    display: block;
  }
  .related {
    margin-top: 2rem;
  }
  .related ul {
    list-style: none;
    padding: 0;
  }
  .related a {
    text-decoration: none;
  }
  .related a:hover {
    text-decoration: underline;
  }
</style>

<script>
  function permalink(): string {
    const canonical = document.querySelector<HTMLLinkElement>('link[rel="canonical"]');
    return canonical?.href || window.location.href;
  }

  function status(): HTMLElement | null {
    return document.querySelector<HTMLElement>("[data-share-status]");
  }

  function flash(msg: string) {
    const el = status();
    if (!el) return;
    el.textContent = msg;
    setTimeout(() => {
      el.textContent = "";
    }, 1500);
  }

  async function copyLink(btn: HTMLButtonElement) {
    try {
      await navigator.clipboard.writeText(permalink());
      btn.classList.add("copied");
      flash("Copied");
      setTimeout(() => btn.classList.remove("copied"), 1500);
    } catch (e) {
      flash("Press Ctrl+C");
    }
  }

  function bindShare() {
    const copyBtn = document.querySelector<HTMLButtonElement>("[data-copy-link]");
    if (copyBtn && !copyBtn.dataset.bound) {
      copyBtn.dataset.bound = "true";
      copyBtn.addEventListener("click", () => copyLink(copyBtn));
    }

    const shareBtn = document.querySelector<HTMLButtonElement>("[data-share-link]");
    if (shareBtn && !shareBtn.dataset.bound) {
      shareBtn.dataset.bound = "true";
      if (typeof navigator.share === "function") {
        shareBtn.hidden = false;
        shareBtn.addEventListener("click", async () => {
          try {
            await navigator.share({ title: document.title, url: permalink() });
          } catch (e) {
            /* user dismissed the share sheet; ignore */
          }
        });
      }
    }
  }

  // Re-bind after each View Transition swap; the buttons are fresh nodes.
  document.addEventListener("astro:page-load", bindShare);
  bindShare();
</script>
