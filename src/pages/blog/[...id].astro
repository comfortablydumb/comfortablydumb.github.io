---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { getPosts, readingTime, slugifyTag } from "../../utils/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const mins = d.readingTime ?? readingTime(post.body);

const all = await getPosts();
const related = all
  .filter((p) => p.id !== post.id)
  .filter(
    (p) =>
      p.data.category === d.category ||
      p.data.tags.some((t) => d.tags.includes(t)),
  )
  .slice(0, 3);
---

<BaseLayout
  title={d.title}
  description={d.description}
  image={`/og/${post.id}.png`}
  type="article"
  publishDate={d.pubDate}
  modifiedDate={d.updatedDate}
  tags={d.tags}
>
  <article data-pagefind-body>
    <header class="post-head">
      <h1>{d.title}</h1>
      <p class="post-meta text-muted">
        <FormattedDate date={d.pubDate} /> · {mins} min read · {d.category}
        {d.updatedDate && <> · updated <FormattedDate date={d.updatedDate} /></>}
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="post-foot">
      <p class="tags">
        {d.tags.map((t) => <a href={`/tags/${slugifyTag(t)}`}>#{t}</a>)}
      </p>
      <div class="foot-row">
        <a href="/blog" class="back">← All notes</a>
        <button type="button" class="copy-link" data-copy-link data-pagefind-ignore aria-live="polite">
          Copy link
        </button>
      </div>
    </footer>

    {
      related.length > 0 && (
        <section class="related" data-pagefind-ignore>
          <h2>Related</h2>
          <ul>
            {related.map((p) => (
              <li>
                <a href={`/blog/${p.id}`}>{p.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .post-head {
    margin-bottom: 1.5rem;
  }
  .post-meta {
    font-size: 0.88rem;
    margin-top: 0.4rem;
  }
  .post-foot {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0 0 0.75rem;
  }
  .tags a {
    font-size: 0.88rem;
    color: var(--text-muted);
    text-decoration: none;
  }
  .tags a:hover {
    color: var(--link);
  }
  .back {
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--text-muted);
  }
  .back:hover {
    color: var(--link);
  }
  .foot-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .copy-link {
    font: inherit;
    font-size: 0.9rem;
    color: var(--text-muted);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }
  .copy-link:hover {
    color: var(--link);
  }
  .copy-link.copied {
    color: var(--link);
  }
  .related {
    margin-top: 2rem;
  }
  .related ul {
    list-style: none;
    padding: 0;
  }
  .related a {
    text-decoration: none;
  }
  .related a:hover {
    text-decoration: underline;
  }
</style>

<script>
  function permalink(): string {
    const canonical = document.querySelector<HTMLLinkElement>('link[rel="canonical"]');
    return canonical?.href || window.location.href;
  }

  function bindCopy() {
    const btn = document.querySelector<HTMLButtonElement>("[data-copy-link]");
    if (!btn || btn.dataset.bound) return;
    btn.dataset.bound = "true";
    const original = btn.textContent;
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(permalink());
        btn.textContent = "Copied";
        btn.classList.add("copied");
        setTimeout(() => {
          btn.textContent = original;
          btn.classList.remove("copied");
        }, 1500);
      } catch (e) {
        btn.textContent = "Press Ctrl+C";
        setTimeout(() => {
          btn.textContent = original;
        }, 1500);
      }
    });
  }

  // Re-bind after each View Transition swap; the button is a fresh node.
  document.addEventListener("astro:page-load", bindCopy);
  bindCopy();
</script>
