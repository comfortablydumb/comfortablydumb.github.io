---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { getPosts, readingTime, slugifyTag } from "../../utils/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const mins = d.readingTime ?? readingTime(post.body);

const all = await getPosts();
const idx = all.findIndex((p) => p.id === post.id);
const prev = idx < all.length - 1 ? all[idx + 1] : null; // older
const next = idx > 0 ? all[idx - 1] : null; // newer

const related = all
  .filter((p) => p.id !== post.id)
  .filter(
    (p) =>
      p.data.category === d.category ||
      p.data.tags.some((t) => d.tags.includes(t)),
  )
  .slice(0, 3);
---

<BaseLayout
  title={d.title}
  description={d.description}
  image={`/og/${post.id}.png`}
  type="article"
  publishDate={d.pubDate}
  modifiedDate={d.updatedDate}
  tags={d.tags}
>
  <article data-pagefind-body>
    <header class="post-head">
      <h1>{d.title}</h1>
      <p class="post-meta text-muted">
        <FormattedDate date={d.pubDate} /> · {mins} min read · {d.category}
        {d.updatedDate && <> · updated <FormattedDate date={d.updatedDate} /></>}
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="post-foot">
      <p class="tags">
        {d.tags.map((t) => <a href={`/tags/${slugifyTag(t)}`}>#{t}</a>)}
      </p>

      {
        (prev || next) && (
          <nav class="post-nav" aria-label="More notes">
            {prev ? (
              <a class="nav-prev" href={`/blog/${prev.id}`}>
                <span class="nav-label">← Previous</span>
                <span class="nav-title">{prev.data.title}</span>
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a class="nav-next" href={`/blog/${next.id}`}>
                <span class="nav-label">Next →</span>
                <span class="nav-title">{next.data.title}</span>
              </a>
            )}
          </nav>
        )
      }

      <div class="foot-row">
        <a href="/blog" class="back">← All notes</a>
        <div class="share" data-pagefind-ignore>
          <span class="share-status" data-share-status role="status" aria-live="polite"></span>
          <button type="button" class="icon-btn" data-share-link aria-label="Share" title="Share">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="18" cy="5" r="3"></circle>
              <circle cx="6" cy="12" r="3"></circle>
              <circle cx="18" cy="19" r="3"></circle>
              <path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"></path>
            </svg>
          </button>
        </div>
      </div>
    </footer>

    {
      related.length > 0 && (
        <section class="related" data-pagefind-ignore>
          <h2>Related</h2>
          <ul>
            {related.map((p) => (
              <li>
                <a href={`/blog/${p.id}`}>{p.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .post-head {
    margin-bottom: 1.5rem;
  }
  .post-meta {
    font-size: 0.88rem;
    margin-top: 0.4rem;
  }
  .post-foot {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0 0 0.75rem;
  }
  .tags a {
    font-size: 0.88rem;
    color: var(--text-muted);
    text-decoration: none;
  }
  .tags a:hover {
    color: var(--link);
  }
  .back {
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--text-muted);
  }
  .back:hover {
    color: var(--link);
  }
  .foot-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .post-nav {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin: 0 0 1.5rem;
  }
  .post-nav a {
    display: block;
    max-width: 47%;
    text-decoration: none;
    color: var(--text);
  }
  .nav-next {
    margin-left: auto;
    text-align: right;
  }
  .nav-label {
    display: block;
    font-size: 0.78rem;
    color: var(--text-faint);
  }
  .nav-title {
    display: block;
    font-size: 0.92rem;
    line-height: 1.35;
  }
  .post-nav a:hover .nav-title {
    color: var(--link);
  }
  .share {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .share-status {
    font-size: 0.8rem;
    color: var(--text-faint);
  }
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    padding: 0;
    color: var(--text-muted);
    cursor: pointer;
  }
  .icon-btn:hover {
    color: var(--link);
  }
  .related {
    margin-top: 2rem;
  }
  .related ul {
    list-style: none;
    padding: 0;
  }
  .related a {
    text-decoration: none;
  }
  .related a:hover {
    text-decoration: underline;
  }
</style>

<script>
  function permalink(): string {
    const canonical = document.querySelector<HTMLLinkElement>('link[rel="canonical"]');
    return canonical?.href || window.location.href;
  }

  function flash(msg: string) {
    const el = document.querySelector<HTMLElement>("[data-share-status]");
    if (!el) return;
    el.textContent = msg;
    setTimeout(() => {
      el.textContent = "";
    }, 1500);
  }

  // Native share sheet where supported (mostly mobile), copy the link
  // everywhere else so the one button always does something useful.
  async function shareOrCopy() {
    const url = permalink();
    if (typeof navigator.share === "function") {
      try {
        await navigator.share({ title: document.title, url });
      } catch (e) {
        /* user dismissed the share sheet; ignore */
      }
      return;
    }
    try {
      await navigator.clipboard.writeText(url);
      flash("Link copied");
    } catch (e) {
      flash("Press Ctrl+C");
    }
  }

  function bindShare() {
    const btn = document.querySelector<HTMLButtonElement>("[data-share-link]");
    if (!btn || btn.dataset.bound) return;
    btn.dataset.bound = "true";
    btn.addEventListener("click", shareOrCopy);
  }

  // Re-bind after each View Transition swap; the button is a fresh node.
  document.addEventListener("astro:page-load", bindShare);
  bindShare();
</script>
