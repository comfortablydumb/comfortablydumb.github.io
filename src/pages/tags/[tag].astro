---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import PostCard from "../../components/PostCard.astro";
import { getPosts, getTags, slugifyTag } from "../../utils/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = await getTags();

  // Build the set of slugs from both tags and categories so /tags/<category> works too.
  const slugMap = new Map<string, string>();
  for (const { tag } of tags) slugMap.set(slugifyTag(tag), tag);
  for (const p of posts) slugMap.set(slugifyTag(p.data.category), p.data.category);

  return [...slugMap.entries()].map(([slug, label]) => {
    const matching = posts.filter(
      (p) =>
        p.data.category === label ||
        p.data.tags.some((t) => slugifyTag(t) === slug),
    );
    return { params: { tag: slug }, props: { label, posts: matching } };
  });
}

const { label, posts } = Astro.props;
---

<BaseLayout
  title={`#${label}`}
  description={`Articles tagged ${label} by Samarth Jindal.`}
>
  <PageHeader
    eyebrow="Tag"
    title={`#${label}`}
    description={`${posts.length} article${posts.length === 1 ? "" : "s"} on ${label}.`}
  />

  <div class="container section">
    <a class="back-link" href="/blog">← All articles</a>
    <div class="post-list" style="margin-top:1rem">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </div>
</BaseLayout>

<style>
  .back-link {
    font-size: 0.9rem;
    font-family: var(--font-mono);
  }
</style>
