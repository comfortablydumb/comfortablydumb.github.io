---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { SOCIALS } from "../config";
---

<BaseLayout
  title="Contact"
  description="Get in touch with Samarth Jindal. Open to engineering conversations, opportunities, and collaboration."
>
  <PageHeader
    title="Get in touch"
    description="Open to conversations about distributed systems, reliability, and interesting engineering problems."
  />

  <p class="lead">
    Whether you want to talk shop, swap notes on a problem, or just say hello, my inbox is open.
    The fastest way to reach me is email, and I'm happy to connect on LinkedIn too.
  </p>

  <ul class="links">
    <li>
      <a href={`mailto:${SOCIALS.email}`}>
        <span class="label">Email</span>
        <span class="value">{SOCIALS.email}</span>
      </a>
    </li>
    <li>
      <a href={SOCIALS.linkedin} target="_blank" rel="noopener noreferrer">
        <span class="label">LinkedIn</span>
        <span class="value">in/jindalsamarth</span>
      </a>
    </li>
  </ul>
</BaseLayout>

<style>
  .lead {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin-bottom: 1.75rem;
    max-width: 38rem;
  }
  .links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  .links a {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .links a:hover {
    border-color: var(--link);
  }
  .label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }
  .value {
    font-size: 1.05rem;
    color: var(--text);
  }
</style>
