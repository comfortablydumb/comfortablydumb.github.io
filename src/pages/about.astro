---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Timeline from "../components/Timeline.astro";
---

<BaseLayout
  title="About"
  description="Samarth Jindal, software engineer building reliable distributed systems at scale."
>
  <PageHeader
    title="About"
    description="Senior software engineer working on scalable systems and backend engineering."
  />

  <div class="prose">
    <p>
      I'm currently a senior software engineer at Sprinklr, where my work revolves around
      scalable systems and backend engineering. I've previously worked at the University of
      Cambridge, 88 Ventures, and DRDO.
    </p>
    <p>
      At Sprinklr I build customer feedback management platforms, social listening and research
      insight products, and tooling to understand and reduce customer churn. What I care about
      most is the layer underneath: the backend systems that have to stay reliable and fast as
      they scale.
    </p>
  </div>

  <section class="section">
    <h2>Experience &amp; education</h2>
    <Timeline />
  </section>
</BaseLayout>

<style>
  .section {
    margin-top: 2rem;
  }
  .section h2 {
    margin-bottom: 1.25rem;
  }
</style>
